# WatZap: API Key dari menu INTEGRATIONS > API Key,
# Number Key dari nomor di tab WhatsApp > API.
WATZAP_API_KEY=
WATZAP_NUMBER_KEY=
# Nomor WhatsApp tujuan dalam format internasional tanpa tanda +, contoh 6281234567890.
WATZAP_PHONE_NO=
# Tujuan pengiriman: phone (default) atau group.
WHATSAPP_TARGET=phone
# ID grup dari WatZap, berakhiran @g.us; diperlukan jika WHATSAPP_TARGET=group.
WATZAP_GROUP_ID=

# Cloudinary credentials: screenshot akan diunggah dan dapat diakses lewat URL publik.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Konfigurasi chart dan screenshot
TRADINGVIEW_SYMBOL=BINANCE:BTCUSDT
TRADINGVIEW_INTERVAL=15
# Opsional: URL chart tersimpan yang berisi layout, indikator, dan drawing.
TRADINGVIEW_CHART_URL=
CHART_WAIT_SECONDS=8
SCREENSHOT_PATH=screenshots/chart.png
WHATSAPP_CAPTION=Screenshot chart TradingView
